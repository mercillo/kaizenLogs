# Copy to .env.local and fill in. Never commit .env.local.
#
# Local stack: run `pnpm supabase status` after `pnpm supabase start` for these values.
# Hosted: Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth (M2). Read by supabase/config.toml for the local stack.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Claude API (M7). Server-only; never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
